NODE_ENV=development
PORT=3000
DB_PATH=./data/payments.db
DB_ENGINE=sqlite
DATABASE_URL=
MOCK_PAYMENT=true
# Production must set MOCK_PAYMENT=false and provide PAYMENT_CREDENTIALS_JSON.
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_AUTH_ENABLED=false
# Production must set ADMIN_AUTH_ENABLED=true and use a unique password of at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-in-production
SECURE_COOKIES=false
# Production must set SECURE_COOKIES=true when PUBLIC_BASE_URL uses HTTPS.
RECONCILIATION_ENABLED=false
RECONCILIATION_INTERVAL_MINUTES=60
SETTLEMENT_AUTO_ENABLED=false
SETTLEMENT_AUTO_INTERVAL_MINUTES=60
PAYMENT_RECOVERY_ENABLED=false
PAYMENT_RECOVERY_INTERVAL_MINUTES=5
REFUND_RECOVERY_ENABLED=true
REFUND_RECOVERY_INTERVAL_MINUTES=5
CHANNEL_FAILURE_THRESHOLD=3
CALLBACK_RETRY_ENABLED=true
CALLBACK_RETRY_INTERVAL_MINUTES=1
MERCHANT_WEBHOOK_ENABLED=true
MERCHANT_WEBHOOK_INTERVAL_MINUTES=1
MERCHANT_API_AUTH_ENABLED=false
MERCHANT_SIGNATURE_REQUIRED=false
MERCHANT_SIGNATURE_WINDOW_SECONDS=300
# Optional comma-separated source IPs for signed merchant requests.
MERCHANT_IP_ALLOWLIST=
METRICS_TOKEN=
REDIS_URL=
DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Optional: encrypt backup files with AES-256-GCM. Keep this outside the repo.
BACKUP_ENCRYPTION_KEY=
# Live mode reads APIv2 credential objects by credentialRef from this JSON value.
# PAYMENT_CREDENTIALS_JSON={"mch-190000xxxx":{"mchid":"190000xxxx","apiV2Key":"..."}}
